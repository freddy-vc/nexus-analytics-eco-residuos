# Copiar este archivo como .env y completar los valores

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecoresiduos
DB_USER=postgres
DB_PASSWORD=

# Entorno de ejecución: development | production
APP_ENV=development

# Clave para firmar la cookie de sesión (opcional; si se omite se deriva de la conexión)
APP_SECRET=
