o (capa relajada) o coordinación entre servicios." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B1B1B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1066" y="1582" width="774" height="26" as="geometry"/></mxCell><mxCell id="n90" value="Funciones sin estado del dominio usadas directamente por algunas vistas" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#64748B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="6" y="830" width="136" height="110" as="geometry"/></mxCell><mxCell id="n92" value="La vista comparación exporta el reporte PDF" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#64748B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2850" y="870" width="150" height="60" as="geometry"/></mxCell><mxCell id="pres" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="84" width="2600" height="380" as="geometry"/></mxCell><mxCell id="dom" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="1070" width="1650" height="270" as="geometry"/></mxCell><mxCell id="dat" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1890" y="1070" width="910" height="270" as="geometry"/></mxCell><mxCell id="p_red" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="244" y="1110" width="247" height="214" as="geometry"/></mxCell><mxCell id="p_exacto" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="505" y="1110" width="247" height="214" as="geometry"/></mxCell><mxCell id="p_genetico" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="766" y="1110" width="555" height="214" as="geometry"/></mxCell><mxCell id="p_sensibilidad" value="" style="rounded=0;