        <mxCell id="L1328" parent="L1324" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;" value="&lt;b&gt;Estereotipo:&lt;/b&gt; rol de la clase entre «». «entity», «dataclass», «enumeration», «singleton» (metaclass=MetaSingleton), «módulo», «componente», «página Streamlit», «externa»." vertex="1">
          <mxGeometry height="37.92857142857142" width="1860.3508771929826" x="507.3684210526316" y="74.17142857142856" as="geometry" />
        </mxCell>
        <mxCell id="L1329" parent="L1324" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;" value="&lt;b&gt;Nombre de la clase&lt;/b&gt; en negrita. En «módulo», «componente» y «página Streamlit» es el archivo .py y sus filas son las funciones y variables de ese archivo." vertex="1">
          <mxGeometry height="37.92857142857142" width="1860.3508771929826" x="507.3684210526316" y="112.09999999999998" as="geometry" />
        </mxCell>
        <mxCell id="L1330" parent="L1324" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;" value="&lt;b&gt;Sección de campos (atributos):&lt;/b&gt; formato: &lt;i&gt;visibilidad nombre : Tipo = valor por defecto&lt;/i&gt;. Los subrayados son atributos de clase (estáticos)." vertex="1">
          <mxGeometry height="37.92857142857142" width="1860.3508771929826" x="507.3684210526316" y="164.35714285714283" as="geometry" />
        </mxCell>
        <mxCell id="L1331" parent="L1324" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;" value="Modificadores: &lt;b&gt;+&lt;/b&gt; público &amp;nbsp; &lt;b&gt;&amp;minus;&lt;/b&gt; privado (prefijo _ en Python)." vertex="1">
          <mxGeometry height="33.71428571428571" width="1860.3508771929826" x="507.3684210526316" y="206.49999999999997" as="geometry" />
        </mxCell>
        <mxCell id="L1332" parent="L1324" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;" value="El campo en negrita es la clave primaria (mapped_column(..., primary_key=True))." vertex="1">
          <mxGeometry height="33.71428571428571" width="1860.3508771929826" x="507.3684210526316" y="246.95714285714283" as="geometry" />
        </mxCell>
        <mxCell id="L1333" parent="L1324" style="shape=line;strokeColor=#AAAAAA;fillColor=none;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="8.428571428571427" width="1860.3508771929826" x="507.3684210526316" y="293.3142857142857" as="geometry" />
        </mxCell>
        <mxCell id="L1334" parent="L1324" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;" value="&lt;b&gt;Sección de métodos:&lt;/b&gt; formato: &lt;i&gt;visibilidad nombre(param:Tipo = defecto) : TipoRetorno&lt;/i&gt;. Subrayado = @staticmethod; «property» = @property; «dialog» = @st.dialog." vertex="1">
          <mxGeometry height="37.92857142857142" width="1860.3508771929826" x="507.3684210526316" y="307.6428571428571" as="geometry" />
        </mxCell>
        <mxCell id="L1335" parent="L1324" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;" value="&lt;b&gt;Multiplicidades sobre las flechas:&lt;/b&gt; &lt;b&gt;1&lt;/b&gt; exactamente uno &amp;nbsp; &lt;b&gt;*&lt;/b&gt; cero o mas (coleccion) &amp;nbsp; &lt;b&gt;0..1&lt;/b&gt; cero o uno (opcional) &amp;nbsp; &lt;b&gt;1..*&lt;/b&gt; uno o mas" vertex="1">
          <mxGeometry height="37.92857142857142" width="1860.3508771929826" x="507.3684210526316" y="354" as="geometry" />
        </mxCell>
        <mxCell id="L1336" parent="L1324" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;" value="En este proyecto: &lt;b&gt;1&lt;/b&gt; en el lado dueño y &lt;b&gt;*&lt;/b&gt; en el lado colección reflejan relationship() y ForeignKey de SQLAlchemy." vertex="1">
          <mxGeometry height="37.92857142857142" width="1860.3508771929826" x="507.3684210526316" y="397.8285714285714" as="geometry" />
        </mxCell>
        <mxCell id="L1337" parent="L1324" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;" value="&lt;b&gt;Tipos:&lt;/b&gt; anotaciones de Python tal como están en el código: int, float, str, bool, list[T], dict[K, V], T | None, np.ndarray, Callable[[...], R], Session (SQLAlchemy)." vertex="1">
          <mxGeometry height="46.357142857142854" width="1860.3508771929826" x="507.3684210526316" y="441.65714285714284" as="geometry" />
        </mxCell>
        <mxCell id="L1338" parent="L1324" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;" value="&lt;b&gt;Separador horizontal&lt;/b&gt; dentro de la caja: divide la seccion de campos (arriba) de la seccion de metodos (abajo). Convencion estandar UML." vertex="1">
          <mxGeometry height="37.92857142857142" width="1860.3508771929826" x="507.3684210526316" y="497.2857142857143" as="geometry" />
        </mxCell>
        <mxCell id="c1339" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#1e1e1e;strokeWidth=2;arcSize=5;align=left;verticalAlign=middle;fontSize=22;spacingLeft=20;" value="&lt;b&gt;Generalización (herencia):&lt;/b&gt; línea sólida con triángulo hueco hacia la clase base. Ej: ErrorValidacion → ErrorEcoResiduos, _Documento → FPDF, entidades → ModeloBase." vertex="1">
          <mxGeometry x="2510" y="6540" width="1315" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c1340" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#1e1e1e;strokeWidth=2;arcSize=5;align=left;verticalAlign=middle;fontSize=22;spacingLeft=20;" value="&lt;b&gt;«singleton»:&lt;/b&gt; la clase usa metaclass=MetaSingleton, por lo que existe una única instancia compartida entre las sesiones de Streamlit (servicios, BaseDatos y Configuracion)." vertex="1">
          <mxGeometry x="2510" y="6780" width="1315" height="200" as="geometry" />
        </mxCell>
