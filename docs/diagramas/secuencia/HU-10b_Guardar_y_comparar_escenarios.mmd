%% HU-10 · Guardar la simulación como escenarios y compararlos
sequenceDiagram
    actor A as Analista
    participant SEN as ServicioSensibilidad
    participant ESC as ServicioEscenarios
    participant SOP as ServicioOptimizacion
    participant GEN as ServicioGenetico
    participant BD as BaseDatos
    participant SES as Session (SQLAlchemy)
    participant CMP as ServicioComparacion
    A->>+SEN: guardar_como_escenarios(escenario: DatosEscenario, usuario_id: int,<br/>tipo: str, indice: int | None, puntos: list[PuntoSimulacion],<br/>parametros_ag: ParametrosAG | None, al_avanzar: Callable[[int, int],<br/>None] | None): int
    alt solo hay la variación 0 %
        SEN-->>A: ErrorValidacion
    else hay variaciones
        SEN->>+BD: sesion(): Iterator[Session]
        BD-->>-SEN: Session
        SEN->>+SES: scalar(statement: Select[tuple[int]]): int | None
        SES-->>-SEN: int | None
        SEN->>+SES: add(instance: AnalisisSensibilidad): None
        SES-->>-SEN: None
        SEN->>+SES: flush(): None
        SES-->>-SEN: None
        BD->>+SES: commit(): None
        SES-->>-BD: None
        loop por cada variación distinta de 0 %
            SEN->>SEN: _nombre_libre(usuario_id: int, nombre: str): str
            SEN->>+ESC: duplicar(escenario_id: int, usuario_id: int, nombre: str | None,<br/>descripcion: str | None): int
            ESC-->>-SEN: int
            SEN->>+ESC: aplicar_variacion(escenario_id: int, tipo: str, empresa_id: int | None,<br/>planta_id: int | None, variacion_pct: float): None
            ESC-->>-SEN: None
            SEN->>+ESC: cargar(escenario_id: int): DatosEscenario
            ESC-->>-SEN: DatosEscenario
            SEN->>+SOP: resolver_exacto(escenario: DatosEscenario): EjecucionExacta
            SOP-->>-SEN: EjecucionExacta
            opt la simulación usó el AG
                SEN->>+GEN: resolver(escenario: DatosEscenario, parametros: ParametrosAG, corridas: int,<br/>al_avanzar: Callable[[int, int, int, int], None] | None): LoteAG
                GEN-->>-SEN: LoteAG
            end
            SEN->>+SES: add(instance: PuntoSensibilidad): None
            SES-->>-SEN: None
            BD->>+SES: commit(): None
            SES-->>-BD: None
        end
        SEN-->>A: int
    end
    deactivate SEN
    A->>+ESC: resumenes(metodo: str): list[TarjetaEscenario]
    ESC-->>-A: list[TarjetaEscenario]
    A->>+CMP: por_escenarios(ids: list[int] | None): list[FilaComparacion]
    CMP-->>-A: list[FilaComparacion]
