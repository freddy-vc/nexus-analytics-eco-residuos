%% HU-11 · Comparación exacto vs. algoritmo genético
sequenceDiagram
    actor A as Analista
    participant ESC as ServicioEscenarios
    participant SOP as ServicioOptimizacion
    participant GEN as ServicioGenetico
    participant CMP as ServicioComparacion
    participant BD as BaseDatos
    participant SES as Session (SQLAlchemy)
    participant FC as fila: FilaComparacion
    participant LT as lote: LoteAG
    participant MT as ModeloTransporte
    participant AGA as AlgoritmoGenetico
    participant RAG as resultado: ResultadoAG
    A->>+ESC: cargar(escenario_id: int): DatosEscenario
    ESC-->>-A: DatosEscenario

    A->>+SOP: ultima_exacta(escenario: DatosEscenario,<br/>ejecucion_id: int | None): EjecucionExacta | None
    SOP-->>-A: EjecucionExacta | None
    A->>+GEN: ultimo_lote(escenario: DatosEscenario): LoteAG | None
    GEN-->>-A: LoteAG | None
    A->>+LT: «property» mejor(): CorridaAG
    LT-->>-A: CorridaAG
    A->>+CMP: por_escenarios(ids: list[int] | None): list[FilaComparacion]
    CMP->>+BD: sesion(): Iterator[Session]
    BD-->>-CMP: Session
    CMP->>+SES: scalars(statement: Select[tuple[Escenario]]): ScalarResult[Escenario]
    SES-->>-CMP: ScalarResult[Escenario]
    CMP->>+SES: scalars(statement: Select[tuple[Ejecucion]]): ScalarResult[Ejecucion]
    SES-->>-CMP: ScalarResult[Ejecucion]
    loop por cada escenario
        CMP->>+FC: FilaComparacion(escenario_id: int, escenario: str, es_base: bool,<br/>exacta_id: int | None, costo_exacto: float | None,<br/>milisegundos_exacto: float | None, ag_id: int | None, costo_ag: float | None,<br/>milisegundos_ag: float | None, corridas_ag: int)
        FC-->>-CMP: FilaComparacion
    end
    CMP-->>-A: list[FilaComparacion]
    loop por cada fila
        A->>+FC: «property» gap(): float | None
        FC-->>-A: float | None
    end
    opt medir escalabilidad (10 × 4, 50 × 10 y 100 × 20)
        Note over A,RAG: metrics.medir_escalabilidad(tamanos, parametros, semilla) con instancias aleatorias
        loop por cada tamaño
            A->>+MT: ModeloTransporte(problema: ProblemaTransporte, simplex: Simplex | None)
            MT-->>-A: ModeloTransporte
            A->>+MT: resolver(): SolucionTransporte
            MT-->>-A: SolucionTransporte
            A->>+AGA: AlgoritmoGenetico(problema: ProblemaTransporte, parametros: ParametrosAG)
            AGA-->>-A: AlgoritmoGenetico
            A->>+AGA: ejecutar(al_avanzar: Callable[[int, int], None] | None): ResultadoAG
            AGA-->>-A: ResultadoAG
            A->>+RAG: «property» es_factible(): bool
            RAG-->>-A: bool
        end
    end
