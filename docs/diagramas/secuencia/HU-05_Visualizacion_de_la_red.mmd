%% HU-05 · Visualización de la red logística
sequenceDiagram
    actor A as Analista
    participant ESC as ServicioEscenarios
    participant SOP as ServicioOptimizacion
    participant GEN as ServicioGenetico
    participant DE as escenario: DatosEscenario
    participant NR as NodoRed
    participant G as grafo: nx.DiGraph
    participant RG as ResumenGrafo
    A->>+ESC: cargar(escenario_id: int): DatosEscenario
    ESC-->>-A: DatosEscenario

    A->>+SOP: ultima_exacta(escenario: DatosEscenario,<br/>ejecucion_id: int | None): EjecucionExacta | None
    SOP-->>-A: EjecucionExacta | None
    A->>+GEN: ultimo_lote(escenario: DatosEscenario): LoteAG | None
    GEN-->>-A: LoteAG | None
    A->>+DE: «property» costos_unitarios(): np.ndarray
    DE-->>-A: np.ndarray
    loop por cada empresa (origen) y cada planta (destino)
        A->>+NR: NodoRed(codigo: str, etiqueta: str, cantidad: float, municipio: str,<br/>latitud: float, longitud: float)
        NR-->>-A: NodoRed
    end
    Note over A,G: graph_builder.construir_red(origenes, destinos, distancias, costos, habilitadas, flujos)
    A->>+G: DiGraph()
    G-->>-A: nx.DiGraph
    loop por cada NodoRed
        A->>+G: add_node(node_for_adding: str, **attr: Any): None
        G-->>-A: None
    end
    loop por cada ruta habilitada (distancia, costo y flujo de la solución elegida)
        A->>+G: add_edge(u_of_edge: str, v_of_edge: str, **attr: Any): None
        G-->>-A: None
    end
    Note over A,G: graph_builder.resumir(grafo)
    A->>+G: nodes(data: bool): NodeDataView
    G-->>-A: NodeDataView
    A->>+G: edges(data: bool): OutEdgeDataView
    G-->>-A: OutEdgeDataView
    A->>+G: number_of_nodes(): int
    G-->>-A: int
    A->>+G: number_of_edges(): int
    G-->>-A: int
    A->>+RG: ResumenGrafo(origenes: int, destinos: int, arcos: int, arcos_con_flujo: int)
    RG-->>-A: ResumenGrafo
