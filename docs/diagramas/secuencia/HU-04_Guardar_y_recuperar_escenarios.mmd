%% HU-04 (parcial) · Guardar y recuperar escenarios
sequenceDiagram
    actor A as Analista
    participant ESC as ServicioEscenarios
    participant BD as BaseDatos
    participant SES as Session (SQLAlchemy)
    participant DE as escenario: DatosEscenario
    A->>+ESC: listar(): list[ResumenEscenario]
    ESC->>+BD: sesion(): Iterator[Session]
    BD-->>-ESC: Session
    ESC->>+SES: scalars(statement: Select[tuple[Escenario]]): ScalarResult[Escenario]
    SES-->>-ESC: ScalarResult[Escenario]
    ESC-->>-A: list[ResumenEscenario]
    A->>+ESC: resumenes(metodo: str): list[TarjetaEscenario]
    ESC->>+BD: sesion(): Iterator[Session]
    BD-->>-ESC: Session
    ESC->>+SES: scalars(statement: Select[tuple[Escenario]]): ScalarResult[Escenario]
    SES-->>-ESC: ScalarResult[Escenario]
    ESC->>+SES: execute(statement: Select[tuple[int, Decimal]]): Result
    SES-->>-ESC: Result
    ESC-->>-A: list[TarjetaEscenario]
    alt guardar un escenario nuevo o duplicar uno existente
        A->>+ESC: duplicar(escenario_id: int, usuario_id: int, nombre: str | None,<br/>descripcion: str | None): int
        ESC->>+BD: sesion(): Iterator[Session]
        BD-->>-ESC: Session
        ESC->>+SES: scalar(statement: Select[tuple[Escenario]]): Escenario | None
        SES-->>-ESC: Escenario | None
        alt el escenario de origen no existe
            ESC-->>A: ErrorNoEncontrado
        else existe
            opt sin nombre
                ESC->>ESC: _nombre_copia(sesion: Session, usuario_id: int, base: str): str
            end
            ESC->>ESC: _validar_nombre_libre(sesion: Session, usuario_id: int, nombre: str,<br/>excluir_id: int | None): None
            alt nombre repetido
                ESC-->>A: ErrorValidacion
            else nombre libre
                loop por cada ruta del escenario de origen
                    ESC->>+SES: add(instance: Ruta): None
                    SES-->>-ESC: None
                end
                ESC->>+SES: add(instance: Escenario): None
                SES-->>-ESC: None
                ESC->>+SES: flush(): None
                SES-->>-ESC: None
                BD->>+SES: commit(): None
                SES-->>-BD: None
                ESC-->>A: int
            end
        end
        deactivate ESC
    else recuperar (abrir) un escenario

        A->>+ESC: cargar(escenario_id: int): DatosEscenario
        ESC->>+BD: sesion(): Iterator[Session]
        BD-->>-ESC: Session
        ESC->>+SES: scalar(statement: Select[tuple[Escenario]]): Escenario | None
        SES-->>-ESC: Escenario | None
        alt el escenario no existe
            ESC-->>A: ErrorNoEncontrado
        else existe
            ESC->>+DE: DatosEscenario(id: int, nombre: str, alfa: float, factor_transporte: float,<br/>es_base: bool, origen: str | None, empresas: list[FilaEmpresa],<br/>plantas: list[FilaPlanta], distancias: np.ndarray, ids_rutas: np.ndarray,<br/>habilitadas: np.ndarray)
            DE-->>-ESC: DatosEscenario
            ESC-->>A: DatosEscenario
        end
        deactivate ESC

    end
    Note over A,SES: No implementado de HU-04: importar y exportar datos de la red en CSV, XLSX o JSON
