%% HU-02 · Costos, distancias y coeficientes
sequenceDiagram
    actor A as Analista
    participant ESC as ServicioEscenarios
    participant DE as escenario: DatosEscenario
    participant BD as BaseDatos
    participant SES as Session (SQLAlchemy)
    A->>+ESC: cargar(escenario_id: int): DatosEscenario
    ESC-->>-A: DatosEscenario

    A->>+DE: «property» costos_unitarios(): np.ndarray
    DE->>DE: «property» alfa_efectivo(): float
    DE->>DE: «property» costos_operacion(): np.ndarray
    DE->>DE: «property» precios_compra(): np.ndarray
    DE-->>-A: np.ndarray
    A->>+ESC: guardar_alfa(escenario_id: int, costo_transporte: float): None
    alt costo de transporte ≤ 0
        ESC-->>A: ErrorValidacion
    else válido
        ESC->>+BD: sesion(): Iterator[Session]
        BD-->>-ESC: Session
        ESC->>ESC: _obtener(sesion: Session, escenario_id: int): Escenario
        ESC->>+SES: get(entity: type[Escenario], ident: int): Escenario | None
        SES-->>-ESC: Escenario | None
        Note over ESC: factor_transporte_pct = factor_desde_costo(costo_transporte, alfa_base)
        BD->>+SES: commit(): None
        SES-->>-BD: None
        ESC-->>A: None
    end
    deactivate ESC
    A->>+ESC: guardar_distancias(distancias: dict[int, float]): None
    alt alguna distancia negativa
        ESC-->>A: ErrorValidacion
    else válidas
        ESC->>+BD: sesion(): Iterator[Session]
        BD-->>-ESC: Session
        ESC->>+SES: scalars(statement: Select[tuple[Ruta]]): ScalarResult[Ruta]
        SES-->>-ESC: ScalarResult[Ruta]
        BD->>+SES: commit(): None
        SES-->>-BD: None
        ESC-->>A: None
    end
    deactivate ESC
    A->>+ESC: guardar_parametros(escenario_id: int, nombre: str, factor: float,<br/>empresas: dict[int, tuple[float, float]], plantas: dict[int, tuple[float,<br/>float]]): None
    ESC->>+BD: sesion(): Iterator[Session]
    BD-->>-ESC: Session
    ESC->>ESC: _obtener(sesion: Session, escenario_id: int): Escenario
    ESC->>ESC: _validar_nombre_libre(sesion: Session, usuario_id: int, nombre: str,<br/>excluir_id: int | None): None
    BD->>+SES: commit(): None
    SES-->>-BD: None
    ESC-->>-A: None
