%% HU-01 · Gestión de plantas
sequenceDiagram
    actor A as Analista
    participant ESC as ServicioEscenarios
    participant SOP as ServicioOptimizacion
    participant RED as ServicioRed
    participant BD as BaseDatos
    participant SES as Session (SQLAlchemy)
    participant EE as ejecucion: EjecucionExacta
    A->>+ESC: cargar(escenario_id: int): DatosEscenario
    ESC-->>-A: DatosEscenario

    A->>+SOP: ultima_exacta(escenario: DatosEscenario,<br/>ejecucion_id: int | None): EjecucionExacta | None
    SOP-->>-A: EjecucionExacta | None
    A->>+RED: municipios(): list[ElementoCatalogo]
    RED-->>-A: list[ElementoCatalogo]
    alt crear planta
        A->>+RED: siguiente_codigo(prefijo: str): str
        RED-->>-A: str
        A->>+RED: crear_planta(escenario_id: int, datos: DatosPlanta): None
        RED->>RED: _limpiar_planta(datos: DatosPlanta): DatosPlanta
        RED->>+BD: sesion(): Iterator[Session]
        BD-->>-RED: Session
        RED->>RED: _escenario(sesion: Session, escenario_id: int): Escenario
        RED->>+SES: get(entity: type[Escenario], ident: int): Escenario | None
        SES-->>-RED: Escenario | None
        RED->>RED: _validar_planta_unica(sesion: Session, codigo: str,<br/>excluir_id: int | None): None
        RED->>+SES: scalar(statement: Select[tuple[Planta]]): Planta | None
        SES-->>-RED: Planta | None
        alt sin código o municipio, valores negativos o código repetido
            RED-->>A: ErrorValidacion
        else datos válidos
            RED->>+SES: get(entity: type[Municipio], ident: int): Municipio | None
            SES-->>-RED: Municipio | None
            loop por cada empresa del escenario
                RED->>+SES: add(instance: Ruta): None
                SES-->>-RED: None
            end
            BD->>+SES: commit(): None
            SES-->>-BD: None
            RED-->>A: None
        end
        deactivate RED
    else editar planta
        A->>+RED: actualizar_planta(planta_id: int, id_vinculo: int, datos: DatosPlanta): None
        RED->>RED: _limpiar_planta(datos: DatosPlanta): DatosPlanta
        RED->>+BD: sesion(): Iterator[Session]
        BD-->>-RED: Session
        RED->>+SES: get(entity: type[Planta], ident: int): Planta | None
        SES-->>-RED: Planta | None
        RED->>+SES: get(entity: type[EscenarioPlanta], ident: int): EscenarioPlanta | None
        SES-->>-RED: EscenarioPlanta | None
        alt la planta ya no existe
            RED-->>A: ErrorNoEncontrado
        else existe
            RED->>RED: _validar_planta_unica(sesion: Session, codigo: str,<br/>excluir_id: int | None): None
            opt cambió el municipio
                RED->>+SES: get(entity: type[Municipio], ident: int): Municipio | None
                SES-->>-RED: Municipio | None
            end
            BD->>+SES: commit(): None
            SES-->>-BD: None
            RED-->>A: None
        end
        deactivate RED
    else eliminar planta
        A->>+RED: eliminar_planta(planta_id: int): None
        RED->>+BD: sesion(): Iterator[Session]
        BD-->>-RED: Session
        RED->>+SES: get(entity: type[Planta], ident: int): Planta | None
        SES-->>-RED: Planta | None
        alt la planta ya no existe
            RED-->>A: ErrorNoEncontrado
        else existe
            RED->>+SES: execute(statement: Delete): Result
            SES-->>-RED: Result
            RED->>+SES: execute(statement: Delete): Result
            SES-->>-RED: Result
            RED->>+SES: delete(instance: Planta): None
            SES-->>-RED: None
            BD->>+SES: commit(): None
            SES-->>-BD: None
            RED-->>A: None
        end
        deactivate RED
    end
