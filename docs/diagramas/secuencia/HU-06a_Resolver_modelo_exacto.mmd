%% HU-06 · Resolución con el modelo exacto
sequenceDiagram
    actor A as Analista
    participant ESC as ServicioEscenarios
    participant SOP as ServicioOptimizacion
    participant DE as escenario: DatosEscenario
    participant MT as ModeloTransporte
    participant EB as balance: EstadoBalance
    participant BD as BaseDatos
    participant SES as Session (SQLAlchemy)
    participant EE as ejecucion: EjecucionExacta
    participant RF as factibilidad: ReporteFactibilidad
    A->>+ESC: cargar(escenario_id: int): DatosEscenario
    ESC-->>-A: DatosEscenario

    A->>+SOP: resolver_exacto(escenario: DatosEscenario): EjecucionExacta
    alt sin empresas o plantas, o sin rutas habilitadas
        SOP-->>A: ErrorValidacion
    else datos completos
        SOP->>+DE: problema(): ProblemaTransporte
        DE->>DE: «property» costos_unitarios(): np.ndarray
        DE-->>-SOP: ProblemaTransporte
        SOP->>+MT: ModeloTransporte(problema: ProblemaTransporte, simplex: Simplex | None)
        MT-->>-SOP: ModeloTransporte
        SOP->>+MT: resolver(): SolucionTransporte
        Note over MT: Ver HU-06b
        MT-->>-SOP: SolucionTransporte
        SOP->>SOP: _mensaje_balance(balance: EstadoBalance, escenario: DatosEscenario): str
        opt oferta y demanda desbalanceadas
            SOP->>+EB: «property» diferencia(): float
            EB-->>-SOP: float
        end
        SOP->>+BD: sesion(): Iterator[Session]
        BD-->>-SOP: Session
        SOP->>SOP: _id_catalogo(sesion: Session, modelo: type[ModeloBase], nombre: str): int
        SOP->>+SES: scalar(statement: Select[tuple[int]]): int | None
        SES-->>-SOP: int | None
        SOP->>+SES: add(instance: Ejecucion): None
        SES-->>-SOP: None
        SOP->>+SES: flush(): None
        SES-->>-SOP: None
        opt hay flujos óptimos
            SOP->>+DE: problema(): ProblemaTransporte
            DE-->>-SOP: ProblemaTransporte
            Note over SOP: analysis.analizar(problema) calcula precios sombra y rangos (ver HU-09)
            SOP->>SOP: _guardar_resultados(sesion: Session, ejecucion_id: int,<br/>escenario: DatosEscenario, flujos: np.ndarray,<br/>analisis: AnalisisSensibilidad | None): None
            SOP->>+SES: add_all(instances: Iterable[ResultadoRuta]): None
            SES-->>-SOP: None
            SOP->>+SES: add_all(instances: Iterable[SensibilidadOferta]): None
            SES-->>-SOP: None
            SOP->>+SES: add_all(instances: Iterable[SensibilidadDemanda]): None
            SES-->>-SOP: None
        end
        BD->>+SES: commit(): None
        SES-->>-BD: None
        SOP->>SOP: ultima_exacta(escenario: DatosEscenario,<br/>ejecucion_id: int | None): EjecucionExacta | None
        SOP->>+SES: scalars(statement: Select[tuple[Ejecucion]]): ScalarResult[Ejecucion]
        SES-->>-SOP: ScalarResult[Ejecucion]
        SOP->>SOP: _a_ejecucion(ejecucion: Ejecucion, escenario: DatosEscenario): EjecucionExacta
        SOP->>+DE: «property» alfa_efectivo(): float
        DE-->>-SOP: float
        SOP->>+DE: «property» oferta(): np.ndarray
        DE-->>-SOP: np.ndarray
        SOP->>+DE: «property» demanda(): np.ndarray
        DE-->>-SOP: np.ndarray
        Note over SOP: desglose_costo(...) y validar_solucion(...) arman el desglose y la verificación de factibilidad
        SOP->>+EE: EjecucionExacta(ejecucion_id: int, estado: str, objetivo: float | None,<br/>milisegundos: float, iteraciones: int, ejecutada_en: datetime,<br/>mensaje: str | None, flujos: np.ndarray | None, balance: EstadoBalance,<br/>desglose: DesgloseCosto | None, factibilidad: ReporteFactibilidad | None,<br/>num_variables: int, num_restricciones: int)
        EE-->>-SOP: EjecucionExacta
        SOP-->>A: EjecucionExacta
    end
    deactivate SOP
    A->>+EE: «property» es_optima(): bool
    EE-->>-A: bool
    A->>+EE: «property» costo_total(): float | None
    EE-->>-A: float | None
    A->>+RF: «property» es_factible(): bool
    RF->>RF: «property» violaciones(): int
    RF-->>-A: bool
