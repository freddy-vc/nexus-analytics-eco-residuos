%% HU-09 · Análisis de sensibilidad
sequenceDiagram
    actor A as Analista
    participant ESC as ServicioEscenarios
    participant SEN as ServicioSensibilidad
    participant DE as escenario: DatosEscenario
    participant PT as problema: ProblemaTransporte
    participant SX as Simplex
    participant BO as base: BaseOptima
    participant AS as analisis: AnalisisSensibilidad
    participant SR as ruta: SensibilidadRuta
    A->>+ESC: cargar(escenario_id: int): DatosEscenario
    ESC-->>-A: DatosEscenario

    A->>+SEN: analizar(escenario: DatosEscenario): AnalisisSensibilidad | None
    alt sin empresas, plantas o rutas habilitadas
        SEN-->>A: None
    else datos completos
        SEN->>+DE: problema(): ProblemaTransporte
        DE-->>-SEN: ProblemaTransporte
        Note over SEN,BO: analysis.analizar(problema) → duals.base_optima(problema)
        SEN->>+PT: «property» dimension(): tuple[int, int]
        PT-->>-SEN: tuple[int, int]
        SEN->>+SX: Simplex(tolerancia: float, max_iteraciones: int, limite_degeneracion: int)
        SX-->>-SEN: Simplex
        SEN->>+SX: resolver(c: np.ndarray, A_igual: np.ndarray | None,<br/>b_igual: np.ndarray | None, A_menor: np.ndarray | None,<br/>b_menor: np.ndarray | None): ResultadoSimplex
        SX-->>-SEN: ResultadoSimplex
        alt no hay óptimo o la base no es cuadrada
            SEN-->>A: None
        else base óptima
            SEN->>+BO: BaseOptima(M: np.ndarray, b: np.ndarray, c: np.ndarray, base: np.ndarray,<br/>B_inv: np.ndarray, duales: np.ndarray, reducidos: np.ndarray,<br/>x_base: np.ndarray, arcos: np.ndarray, m: int, n: int, oferta_igual: bool)
            BO-->>-SEN: BaseOptima
            Note over SEN: duals.flujos(base)
            SEN->>+BO: «property» num_arcos(): int
            BO-->>-SEN: int
            loop por cada empresa i
                SEN->>+BO: fila_oferta(i: int): int
                BO-->>-SEN: int
                Note over SEN: ranging.rango_lado_derecho(base, fila) → rango de factibilidad
            end
            loop por cada planta j
                SEN->>+BO: fila_demanda(j: int): int
                BO-->>-SEN: int
            end
            loop por cada ruta habilitada
                Note over SEN: ranging.rango_costo(base, columna) → rango de optimalidad
            end
            SEN->>+BO: «property» degenerada(): bool
            BO-->>-SEN: bool
            SEN->>+AS: AnalisisSensibilidad(objetivo: float, empresas: list[SensibilidadNodo],<br/>plantas: list[SensibilidadNodo], rutas: list[SensibilidadRuta],<br/>degenerada: bool, oferta_igual: bool)
            AS-->>-SEN: AnalisisSensibilidad
            SEN-->>A: AnalisisSensibilidad
        end
    end
    deactivate SEN
    loop por cada ruta del análisis
        A->>+SR: «property» usada(): bool
        SR-->>-A: bool
    end
