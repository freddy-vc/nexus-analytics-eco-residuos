%% HU-03 · Gestión de oferta y demanda
sequenceDiagram
    actor A as Analista
    participant ESC as ServicioEscenarios
    participant DE as escenario: DatosEscenario
    participant BD as BaseDatos
    participant SES as Session (SQLAlchemy)
    A->>+ESC: cargar(escenario_id: int): DatosEscenario
    ESC->>+BD: sesion(): Iterator[Session]
    BD-->>-ESC: Session
    ESC->>+SES: scalar(statement: Select[tuple[Escenario]]): Escenario | None
    SES-->>-ESC: Escenario | None
    alt el escenario no existe
        ESC-->>A: ErrorNoEncontrado
    else existe
        ESC->>+DE: DatosEscenario(id: int, nombre: str, alfa: float, factor_transporte: float,<br/>es_base: bool, origen: str | None, empresas: list[FilaEmpresa],<br/>plantas: list[FilaPlanta], distancias: np.ndarray, ids_rutas: np.ndarray,<br/>habilitadas: np.ndarray)
        DE-->>-ESC: DatosEscenario
        ESC-->>A: DatosEscenario
    end
    deactivate ESC

    A->>+DE: «property» oferta(): np.ndarray
    DE-->>-A: np.ndarray
    A->>+DE: «property» demanda(): np.ndarray
    DE-->>-A: np.ndarray
    A->>+DE: «property» costos_operacion(): np.ndarray
    DE-->>-A: np.ndarray
    A->>+DE: «property» precios_compra(): np.ndarray
    DE-->>-A: np.ndarray
    Note over A,DE: Con estos datos se validan valores no negativos, datos completos y balance (si hay desbalance se avisa del nodo ficticio)
    A->>+ESC: guardar_parametros(escenario_id: int, nombre: str, factor: float,<br/>empresas: dict[int, tuple[float, float]], plantas: dict[int, tuple[float,<br/>float]]): None
    alt nombre vacío, factor ≤ 0 u oferta, demanda, precio o costo negativos
        ESC-->>A: ErrorValidacion
    else valores válidos
        ESC->>+BD: sesion(): Iterator[Session]
        BD-->>-ESC: Session
        ESC->>ESC: _obtener(sesion: Session, escenario_id: int): Escenario
        ESC->>+SES: get(entity: type[Escenario], ident: int): Escenario | None
        SES-->>-ESC: Escenario | None
        ESC->>ESC: _validar_nombre_libre(sesion: Session, usuario_id: int, nombre: str,<br/>excluir_id: int | None): None
        ESC->>+SES: scalar(statement: Select[tuple[int]]): int | None
        SES-->>-ESC: int | None
        alt ya existe un escenario con ese nombre
            ESC-->>A: ErrorValidacion
        else nombre libre
            BD->>+SES: commit(): None
            SES-->>-BD: None
            ESC-->>A: None
        end
    end
    deactivate ESC
