%% HU-10 · Simulación de escenarios
sequenceDiagram
    actor A as Analista
    participant ESC as ServicioEscenarios
    participant GEN as ServicioGenetico
    participant SEN as ServicioSensibilidad
    participant DE as escenario: DatosEscenario
    participant MT as ModeloTransporte
    participant AGA as AlgoritmoGenetico
    participant RAG as resultado: ResultadoAG
    participant PS as punto: PuntoSimulacion
    A->>+ESC: cargar(escenario_id: int): DatosEscenario
    ESC-->>-A: DatosEscenario

    A->>+GEN: ultimo_lote(escenario: DatosEscenario): LoteAG | None
    GEN-->>-A: LoteAG | None
    A->>+SEN: simular(escenario: DatosEscenario, tipo: str, indice: int | None,<br/>minimo: float, maximo: float, paso: float,<br/>parametros_ag: ParametrosAG | None, al_avanzar: Callable[[int, int],<br/>None] | None): list[PuntoSimulacion]
    alt mínimo ≥ máximo, paso ≤ 0 o más de 21 puntos
        SEN-->>A: ErrorValidacion
    else variaciones válidas
        SEN->>+DE: modelo(): DatosModelo
        DE-->>-SEN: DatosModelo
        Note over SEN,PS: scenario_simulator.simular(datos, tipo, indice, valores, parametros_ag, al_avanzar)
        SEN->>+MT: ModeloTransporte(problema: ProblemaTransporte, simplex: Simplex | None)
        MT-->>-SEN: ModeloTransporte
        SEN->>+MT: resolver(): SolucionTransporte
        MT-->>-SEN: SolucionTransporte
        loop por cada variación (%)
            SEN->>+MT: ModeloTransporte(problema: ProblemaTransporte, simplex: Simplex | None)
            MT-->>-SEN: ModeloTransporte
            SEN->>+MT: resolver(): SolucionTransporte
            MT-->>-SEN: SolucionTransporte
            SEN->>+PS: PuntoSimulacion(variacion_pct: float, costo_exacto: float | None,<br/>milisegundos_exacto: float, costo_ag: float | None,<br/>milisegundos_ag: float | None, ag_factible: bool | None,<br/>balance: TipoBalance, cambia_plan: bool)
            PS-->>-SEN: PuntoSimulacion
            opt se pidió el AG y la solución exacta es óptima
                SEN->>+AGA: AlgoritmoGenetico(problema: ProblemaTransporte, parametros: ParametrosAG)
                AGA-->>-SEN: AlgoritmoGenetico
                SEN->>+AGA: ejecutar(al_avanzar: Callable[[int, int], None] | None): ResultadoAG
                AGA-->>-SEN: ResultadoAG
                SEN->>+RAG: «property» es_factible(): bool
                RAG-->>-SEN: bool
            end
        end
        SEN-->>A: list[PuntoSimulacion]
    end
    deactivate SEN
    loop por cada punto
        A->>+PS: «property» gap(): float | None
        PS-->>-A: float | None
    end
