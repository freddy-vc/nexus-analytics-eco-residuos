%% Transversal · Inicio de sesión
sequenceDiagram
    actor A as Analista
    participant AUT as ServicioAutenticacion
    participant BD as BaseDatos
    participant SES as Session (SQLAlchemy)
    participant US as UsuarioSesion
    A->>+AUT: autenticar(identificador: str, clave: str): UsuarioSesion
    AUT->>+BD: sesion(): Iterator[Session]
    BD-->>-AUT: Session
    AUT->>+SES: scalar(statement: Select[tuple[Usuario]]): Usuario | None
    SES-->>-AUT: Usuario | None
    alt usuario no encontrado o inactivo
        AUT-->>A: ErrorAutenticacion
    else cuenta bloqueada (bloqueado_hasta > ahora)
        AUT-->>A: ErrorAutenticacion
    else usuario encontrado
        Note over AUT: Verifica la contraseña con bcrypt.checkpw
        alt contraseña incorrecta
            AUT->>AUT: _duracion_bloqueo(): str
            AUT->>+SES: commit(): None
            SES-->>-AUT: None
            AUT-->>A: ErrorAutenticacion
        else contraseña correcta
            AUT->>AUT: _a_sesion(usuario: Usuario): UsuarioSesion
            AUT->>+US: UsuarioSesion(id: int, usuario: str, nombres: str, apellidos: str, rol: str)
            US-->>-AUT: UsuarioSesion
            BD->>+SES: commit(): None
            SES-->>-BD: None
            AUT-->>A: UsuarioSesion
        end
    end
    deactivate AUT
    A->>+AUT: emitir_token(usuario: UsuarioSesion): str
    AUT->>AUT: _firmar(contenido: str): str
    AUT-->>-A: str
    A->>+US: «property» iniciales(): str
    US-->>-A: str
    A->>+AUT: validar_token(token: str | None): UsuarioSesion | None
    AUT->>AUT: _firmar(contenido: str): str
    alt firma inválida o token vencido
        AUT-->>A: None
    else token válido
        AUT->>+BD: sesion(): Iterator[Session]
        BD-->>-AUT: Session
        AUT->>+SES: get(entity: type[Usuario], ident: int): Usuario | None
        SES-->>-AUT: Usuario | None
        AUT->>AUT: _a_sesion(usuario: Usuario): UsuarioSesion
        AUT-->>A: UsuarioSesion | None
    end
    deactivate AUT
