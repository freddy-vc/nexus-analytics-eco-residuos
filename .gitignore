# =====================================================================
#  Nexus Analytics · EcoResiduos — .gitignore
# =====================================================================

# --- Python ---------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
*.spec

# --- Entornos virtuales --------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- Variables de entorno y secretos -------------------------------
.env
.env.*
!.env.example
.streamlit/secrets.toml

# --- Herramientas de análisis --------------------------------------
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# --- Jupyter -------------------------------------------------------
.ipynb_checkpoints/
*.ipynb

# --- Resultados generados por la aplicación ------------------------
outputs/
exports/
reports/
logs/
*.log
tmp/

# --- Base de datos local y respaldos -------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
*.backup
pg_data/

# --- IDEs y editores -----------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Sistema operativo ---------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- Archivos temporales de Office y draw.io -----------------------
~$*
.~lock.*#
*.bkp
.$*.drawio
*.drawio.bkp
